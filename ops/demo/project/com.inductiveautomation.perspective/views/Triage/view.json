        "events": {
          "component": {
            "onActionPerformed": [
              {
                "type": "script",
                "scope": "G",
                "config": {
                  "script": "\t# Create a corrective WO in the shared session store: it appears on\n\t# the Schedule board (Maintenance row) and the Maintenance calendar.\n\td = self.session.custom.demo\n\tnow = system.date.now()\n\tms = system.date.toMillis(now)\n\th = system.date.getHour24(now)\n\td0 = system.date.midnight(now)\n\tstart = system.date.addHours(d0, 21 if h >= 21 else h + 1)\n\tend = system.date.addHours(start, 2)\n\tdef iso(dt):\n\t\treturn system.date.format(dt, \"yyyy-MM-dd'T'HH:mm:ss\")\n\two = 'WO-%04d' % (2300 + (ms / 60000) % 1000)\n\ttitle = wo + ' - Downtime escalation'\n\torders = [dict(e) for e in d.orders]\n\torders.append({'id': 'esc-%d' % ms, 'resourceId': 'mx', 'title': title,\n\t\t'start': iso(start), 'end': iso(end), 'category': 'maint',\n\t\t'description': 'Escalated from the downtime triage tree (step: '\n\t\t\t+ str(self.view.custom.sopTitle) + ').'})\n\td.orders = orders\n\tmaint = [dict(e) for e in d.maint]\n\tmaint.append({'id': 'escm-%d' % ms, 'title': title, 'start': iso(start),\n\t\t'end': iso(end), 'category': 'corr',\n\t\t'description': 'Escalated from the downtime triage tree.'})\n\td.maint = maint\n\tself.view.custom.lastWo = (wo + ' created - now on the Schedule board '\n\t\t'(Maintenance row) and the Maintenance calendar.')\n"
                }
              }
            ]
          }
