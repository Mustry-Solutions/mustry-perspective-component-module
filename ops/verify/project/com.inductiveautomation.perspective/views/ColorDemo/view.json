   {
    "type": "ia.display.label",
    "version": 0,
    "props": {
     "text": "Color Picker demo — three presentations of ONE component, all editing view.custom.color. Trigger swatches carry an eyedropper glyph so it's clear they open the panel. Picking on any instance fires onChange (author script persists to custom.color) and the others follow; the preview box + readout are bound to the inline instance's output.* props. Each popover has clear space to open into.",
     "style": {
      "fontSize": "13px"
     }
    },
    "meta": {
     "name": "help"
    },
    "position": {
     "x": 16,
     "y": 10,
     "width": 940,
     "height": 56
    }
   },
   {
    "type": "ia.display.label",
    "version": 0,
    "props": {
     "text": "Version 1 — icon button (popover, showInput false):",
     "style": {
      "fontSize": "12px",
      "fontStyle": "italic"
     }
    },
    "meta": {
     "name": "cap1"
    },
    "position": {
     "x": 16,
     "y": 72,
     "width": 300,
     "height": 18
    }
   },
   {
    "type": "mustrysolutions.input.colorpicker",
    "version": 0,
    "props": {
     "config": {
      "mode": "popover",
      "showAlpha": true,
      "showInput": false,
      "format": "hex"
     }
    },
    "custom": {},
    "propConfig": {
     "props.value.color": {
      "binding": {
       "type": "property",
       "config": {
        "path": "view.custom.color"
       },
       "bidirectional": true
      }
     }
    },
    "events": {
     "component": {
      "onChange": [
       {
        "type": "script",
        "scope": "G",
        "config": {
         "script": "\tself.view.custom.color = event.value\n\tself.view.custom.lastEvent = 'onChange (v1 button) value=' + str(event.value) + '  alpha=' + str(event.alpha)"
        }
       }
      ]
     }
    },
    "meta": {
     "name": "buttonPicker"
    },
    "position": {
     "x": 16,
     "y": 92,
     "width": 44,
     "height": 34
    }
   },
