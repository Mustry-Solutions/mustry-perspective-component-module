{
 "custom": {
  "color": "#0a66c2",
  "lastEvent": ""
 },
 "propConfig": {
  "custom.color": {
   "persistent": true
  },
  "custom.lastEvent": {
   "persistent": true
  }
 },
 "params": {},
 "props": {
  "defaultSize": {
   "width": 1000,
   "height": 560
  }
 },
 "root": {
  "type": "ia.container.coord",
  "version": 0,
  "props": {},
  "meta": {
   "name": "root"
  },
  "children": [
   {
    "type": "ia.display.label",
    "version": 0,
    "props": {
     "text": "Color Picker demo — the inline picker EDITS view.custom.color (two-way). Drag the SV area / hue / alpha bars; releasing a drag fires onChange and writes the value back. The swatch box and readouts are bound to the picker's output.* props, proving the write-back reached the store.",
     "style": {
      "fontSize": "13px"
     }
    },
    "meta": {
     "name": "help"
    },
    "position": {
     "x": 16,
     "y": 10,
     "width": 900,
     "height": 60
    }
   },
   {
    "type": "mustrysolutions.input.colorpicker",
    "version": 0,
    "props": {
     "config": {
      "mode": "inline",
      "showAlpha": true,
      "format": "hex"
     }
    },
    "custom": {},
    "propConfig": {
     "props.value.color": {
      "binding": {
       "type": "property",
       "config": {
        "path": "view.custom.color"
       },
       "bidirectional": true
      }
     }
    },
    "events": {
     "component": {
      "onChange": [
       {
        "type": "script",
        "scope": "G",
        "config": {
         "script": "\t# Controlled round-trip: persist the picked value so the forward binding\n\t# rebinds value.color and the sibling popover picker stays in sync.\n\tself.view.custom.color = event.value\n\tself.view.custom.lastEvent = 'onChange value=' + str(event.value) + '  alpha=' + str(event.alpha)"
        }
       }
      ]
     }
    },
    "meta": {
     "name": "picker"
    },
    "position": {
     "x": 16,
     "y": 78,
     "width": 264,
     "height": 320
    }
   },
   {
    "type": "ia.display.label",
    "version": 0,
    "props": {
     "text": "",
     "style": {
      "borderRadius": "8px",
      "border": "1px solid #cbd2d9"
     }
    },
    "custom": {},
    "propConfig": {
     "props.style.backgroundColor": {
      "binding": {
       "type": "property",
       "config": {
        "path": "../picker.props.output.hex"
       }
      }
     }
    },
    "meta": {
     "name": "preview"
    },
    "position": {
     "x": 300,
     "y": 78,
     "width": 240,
     "height": 120
    }
   },
   {
    "type": "ia.display.label",
    "version": 0,
    "props": {
     "style": {
      "fontSize": "13px",
      "fontFamily": "monospace"
     }
    },
    "custom": {},
    "propConfig": {
     "props.text": {
      "binding": {
       "type": "property",
       "config": {
        "path": "../picker.props.output.hex"
       },
       "transforms": [
        {
         "type": "script",
         "code": "\tp = self.getSibling('picker').props.output\n\trgb = p.rgb\n\thsl = p.hsl\n\treturn 'hex: ' + str(value) + '\\nrgb: (' + str(rgb.r) + ', ' + str(rgb.g) + ', ' + str(rgb.b) + ')\\nhsl: (' + str(hsl.h) + ', ' + str(hsl.s) + '%, ' + str(hsl.l) + '%)\\nalpha: ' + str(p.alpha) + '\\nisValid: ' + str(p.isValid)"
        }
       ]
      }
     }
    },
    "meta": {
     "name": "readout"
    },
    "position": {
     "x": 300,
     "y": 210,
     "width": 380,
     "height": 120
    }
   },
   {
    "type": "ia.display.label",
    "version": 0,
    "props": {
     "style": {
      "fontSize": "12px",
      "color": "#7b8794"
     }
    },
    "custom": {},
    "propConfig": {
     "props.text": {
      "binding": {
       "type": "property",
       "config": {
        "path": "view.custom.lastEvent"
       }
      }
     }
    },
    "meta": {
     "name": "eventLabel"
    },
    "position": {
     "x": 300,
     "y": 340,
     "width": 380,
     "height": 22
    }
   },
   {
    "type": "ia.display.label",
    "version": 0,
    "props": {
     "text": "Popover mode (same bound value) — click the swatch to open the panel; the bound swatch palette + eyedropper live in the panel:",
     "style": {
      "fontSize": "12px",
      "fontStyle": "italic"
     }
    },
    "meta": {
     "name": "popCaption"
    },
    "position": {
     "x": 16,
