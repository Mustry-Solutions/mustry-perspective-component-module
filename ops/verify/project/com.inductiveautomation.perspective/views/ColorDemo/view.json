     "width": 664,
     "height": 20
    }
   },
   {
    "type": "mustrysolutions.input.colorpicker",
    "version": 0,
    "props": {
     "config": {
      "mode": "popover",
      "showAlpha": true,
      "format": "hex"
     }
    },
    "custom": {},
    "propConfig": {
     "props.value.color": {
      "binding": {
       "type": "property",
       "config": {
        "path": "view.custom.color"
       },
       "bidirectional": true
      }
     }
    },
    "events": {
     "component": {
      "onChange": [
       {
        "type": "script",
        "scope": "G",
        "config": {
         "script": "\t# Same controlled round-trip as the inline picker: persist to the shared\n\t# custom prop so both instances stay in sync.\n\tself.view.custom.color = event.value\n\tself.view.custom.lastEvent = 'onChange (popover) value=' + str(event.value) + '  alpha=' + str(event.alpha)"
        }
       }
      ]
     }
    },
    "meta": {
     "name": "popPicker"
    },
    "position": {
     "x": 16,
