              {
                "type": "script",
                "scope": "G",
                "config": {
                  "script": "\t# One handler for every mutation: create / edit / delete / move / resize,\n\t# including recurring scope (series vs single occurrence, like the calendar).\n\t# A reassign is a move whose event.resourceId changed; fromResourceId says from where.\n\tev = event.event\n\taction = event.action\n\tscope = getattr(event, \"scope\", None)            # 'series' | 'occurrence' | None\n\tseriesId = getattr(event, \"seriesId\", None)\n\toccDate = getattr(event, \"occurrenceDate\", None)\n\tevents = [dict(e) for e in self.props.data.events]\n\trecurring = [dict(e) for e in self.props.data.recurringEvents]\n\n\tdef idx_of(lst, eid):\n\t\tfor i in range(len(lst)):\n\t\t\tif lst[i].get(\"id\") == eid:\n\t\t\t\treturn i\n\t\treturn -1\n\n\tdef row_from(e):\n\t\trow = {\"id\": e.id, \"resourceId\": getattr(e, \"resourceId\", \"\"),\n\t\t\t\"title\": getattr(e, \"title\", \"\"), \"start\": getattr(e, \"start\", \"\"),\n\t\t\t\"end\": getattr(e, \"end\", \"\"), \"category\": getattr(e, \"category\", \"\"),\n\t\t\t\"description\": getattr(e, \"description\", \"\")}\n\t\tfor k in (\"color\", \"status\", \"display\"):\n\t\t\tval = getattr(e, k, \"\")\n\t\t\tif val:\n\t\t\t\trow[k] = val\n\t\trr = getattr(e, \"rrule\", None)\n\t\tif rr is not None:\n\t\t\trow[\"rrule\"] = rr\n\t\treturn row\n\n\tdef upsert(lst, row, merge=False):\n\t\ti = idx_of(lst, row.get(\"id\"))\n\t\tif i >= 0:\n\t\t\tif merge:\n\t\t\t\tkept = dict(lst[i])\n\t\t\t\tkept.update(row)\n\t\t\t\tlst[i] = kept\n\t\t\telse:\n\t\t\t\tlst[i] = row\n\t\telse:\n\t\t\tlst.append(row)\n\n\tdef add_exdate(sid, d):\n\t\t# The series may live in data.events or data.recurringEvents.\n\t\tfor lst in (events, recurring):\n\t\t\ti = idx_of(lst, sid)\n\t\t\tif i >= 0:\n\t\t\t\tbase = dict(lst[i])\n\t\t\t\trr = dict(base.get(\"rrule\") or {})\n\t\t\t\tex = list(rr.get(\"exdate\") or [])\n\t\t\t\tif d not in ex:\n\t\t\t\t\tex.append(d)\n\t\t\t\trr[\"exdate\"] = ex\n\t\t\t\tbase[\"rrule\"] = rr\n\t\t\t\tlst[i] = base\n\t\t\t\treturn\n\n\tif scope == \"occurrence\":\n\t\tadd_exdate(seriesId, occDate)          # hide this date in the series\n\t\tif action == \"delete\":\n\t\t\tevents = [e for e in events if e.get(\"id\") != ev.id]\n\t\telse:\n\t\t\tupsert(events, row_from(ev))       # standalone override for this date\n\telif scope == \"series\":\n\t\tif action == \"delete\":\n\t\t\tevents = [e for e in events if e.get(\"id\") != seriesId]\n\t\t\trecurring = [e for e in recurring if e.get(\"id\") != seriesId]\n\t\telse:\n\t\t\t# edit the base wherever it lives (with its rule)\n\t\t\tif idx_of(recurring, seriesId) >= 0:\n\t\t\t\tupsert(recurring, row_from(ev))\n\t\t\telse:\n\t\t\t\tupsert(events, row_from(ev))\n\telse:\n\t\tif action == \"delete\":\n\t\t\tevents = [e for e in events if e.get(\"id\") != ev.id]\n\t\telse:\n\t\t\t# merge keeps fields an older payload might not carry\n\t\t\tupsert(events, row_from(ev), merge=True)\n\n\tself.props.data.events = events\n\tself.props.data.recurringEvents = recurring\n"
                }
