              { "id": "w2", "resourceId": "press2", "title": "Changeover", "start": "2026-06-01T10:00:00Z", "end": "2026-06-01T11:15:00Z" },
              { "id": "w3", "resourceId": "press1", "title": "Late run", "start": "2026-06-01T15:00:00Z", "end": "2026-06-01T19:00:00Z" }
