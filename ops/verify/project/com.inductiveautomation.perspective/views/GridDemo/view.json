{
  "custom": {},
  "params": {},
  "props": {
    "defaultSize": {
      "width": 1100,
      "height": 620
    }
  },
  "root": {
    "type": "ia.container.coord",
    "version": 0,
    "props": {},
    "meta": {
      "name": "root"
    },
    "children": [
      {
        "type": "ia.display.label",
        "version": 0,
        "props": {
          "text": "Data Grid demo (M3) — BATCH editing: edits accumulate (italic + dot + '{n} unsaved'), Save fires one onBatchSave, Discard reverts; paste a TSV range from Excel onto the focused cell; the footer sums Qty over the current view. Everything else still applies (sort/filter/select/reorder/resize/hide/CSV, validation, dropdowns, +/trash).",
          "style": {
            "fontSize": "13px"
          }
        },
        "meta": {
          "name": "help"
        },
        "position": {
          "x": 16,
          "y": 8,
          "width": 880,
          "height": 34
        }
      },
      {
        "type": "ia.display.label",
        "version": 0,
        "props": {
          "text": "theme",
          "style": {
            "fontSize": "11px",
            "color": "#8a8f98",
            "textAlign": "right"
          }
        },
        "meta": {
          "name": "theme_caption"
        },
        "position": {
          "x": 904,
          "y": 16,
          "width": 44,
          "height": 16
        }
      },
      {
        "type": "ia.input.dropdown",
        "version": 0,
        "props": {
          "options": [
            {
              "value": "light",
              "label": "light"
            },
            {
              "value": "light-warm",
              "label": "light-warm"
            },
            {
              "value": "light-cool",
              "label": "light-cool"
            },
            {
              "value": "dark",
              "label": "dark"
            },
            {
              "value": "dark-warm",
              "label": "dark-warm"
            },
            {
              "value": "dark-cool",
              "label": "dark-cool"
            }
          ],
          "allowClear": false
        },
        "propConfig": {
          "props.value": {
            "binding": {
              "type": "property",
              "config": {
                "path": "session.props.theme"
              },
              "bidirectional": true
            },
            "onChange": {
              "enabled": true,
              "script": "\tval = currentValue.value if currentValue else None\n\tif val and val != self.session.props.theme:\n\t\tself.session.props.theme = val\n"
            }
          }
        },
        "meta": {
          "name": "theme_dropdown"
        },
        "position": {
          "x": 954,
          "y": 8,
          "width": 130,
          "height": 32
        }
      },
      {
        "type": "mustrysolutions.input.datagrid",
        "version": 0,
        "props": {
          "config": {
            "rowHeight": 32,
            "columns": [
              {
                "field": "wo",
                "header": "Order",
                "width": 110,
                "pinned": true,
                "editable": false
              },
              {
                "field": "product",
                "header": "Product",
                "width": 150
              },
              {
                "field": "line",
                "header": "Line",
                "width": 90,
                "options": [
                  "Line 1",
                  "Line 2",
                  "Line 3",
                  "Line 4"
                ]
              },
              {
                "field": "qty",
                "header": "Qty",
                "width": 70,
                "align": "right",
                "type": "number",
                "decimals": 0,
                "cellStyles": [
                  {
                    "gt": 900,
                    "background": "#fde68a"
                  }
                ],
                "required": true,
                "min": 0,
                "max": 999,
                "aggregate": "sum"
              },
              {
                "field": "customer",
                "header": "Customer",
                "width": 160
              },
              {
                "field": "batch",
                "header": "Batch",
                "width": 120
              },
              {
                "field": "status",
                "header": "Status",
                "width": 100,
                "cellStyles": [
                  {
                    "equals": "running",
                    "color": "#16a34a"
                  },
                  {
                    "equals": "on hold",
                    "color": "#d97706"
                  },
                  {
                    "equals": "done",
                    "color": "#9ca3af"
                  }
                ],
                "options": [
                  "draft",
                  "released",
                  "running",
                  "done",
                  "on hold"
                ]
              },
              {
                "field": "priority",
                "header": "Priority",
                "width": 90,
                "align": "center",
                "cellStyles": [
                  {
                    "equals": "urgent",
                    "color": "#dc2626"
                  },
                  {
                    "equals": "high",
                    "color": "#d97706"
                  }
                ],
                "options": [
                  "low",
                  "normal",
                  "high",
                  "urgent"
                ]
              },
              {
                "field": "due",
                "header": "Due",
                "width": 130,
                "type": "date"
              },
              {
                "field": "notes",
                "header": "Notes",
                "width": 520
              }
            ],
            "idField": "wo",
            "rowSelect": "multi",
            "showExport": true,
            "editable": true,
            "allowAdd": true,
            "allowDelete": true,
            "editMode": "batch"
          },
          "data": {
            "rows": []
          }
        },
        "propConfig": {
          "props.data.rows": {
            "binding": {
              "type": "expr",
              "config": {
                "expression": "now(0)"
              },
              "transforms": [
                {
                  "type": "script",
                  "code": "\t# Evergreen demo data: 2,500 work orders seeded relative to today (now(0) =\n\t# once per view load). Exercises row virtualization and frozen columns.\n\td0 = system.date.midnight(value)\n\tproducts = [\"Widget A\", \"Widget B\", \"Gasket 12mm\", \"Flange XL\", \"Bearing 6204\", \"Valve V2\", \"Seal Kit\", \"Rotor R9\"]\n\tstatuses = [\"draft\", \"released\", \"running\", \"done\", \"on hold\"]\n\tprios = [\"low\", \"normal\", \"high\", \"urgent\"]\n\trows = []\n\tfor i in range(2500):\n\t\tdue = system.date.addDays(d0, i % 30)\n\t\trows.append({\n\t\t\t\"wo\": \"WO-%05d\" % (10000 + i),\n\t\t\t\"product\": products[i % len(products)],\n\t\t\t\"line\": \"Line %d\" % (1 + i % 4),\n\t\t\t\"qty\": 10 + (i * 7) % 990,\n\t\t\t\"customer\": \"Customer %02d\" % (1 + i % 17),\n\t\t\t\"batch\": \"B-%04d\" % (2000 + i // 5),\n\t\t\t\"status\": statuses[i % len(statuses)],\n\t\t\t\"priority\": prios[(i // 3) % len(prios)],\n\t\t\t\"due\": system.date.format(due, \"yyyy-MM-dd\"),\n\t\t\t\"notes\": (\"Rework of %s after QA hold\" % products[(i + 3) % len(products)]) if i % 7 == 0 else \"\"\n\t\t})\n\treturn rows\n"
                }
              ]
            }
          }
        },
        "custom": {},
        "meta": {
          "name": "grid"
        },
        "position": {
          "x": 16,
          "y": 50,
          "width": 1068,
          "height": 550
        },
        "events": {
          "component": {
            "onCellEdit": [
              {
                "type": "script",
                "scope": "G",
                "config": {
                  "script": "\t# Persist a validated cell edit: upsert the full row by id and rebind.\n\trows = [dict(r) for r in self.props.data.rows]\n\tfor i in range(len(rows)):\n\t\tif rows[i].get(\"wo\") == event.rowId:\n\t\t\trows[i] = dict(event.row)\n\t\t\tbreak\n\tself.props.data.rows = rows\n"
                }
              }
            ],
            "onRowAdd": [
              {
                "type": "script",
                "scope": "G",
                "config": {
                  "script": "\t# Create a new draft work order at the top.\n\trows = [dict(r) for r in self.props.data.rows]\n\tnums = [int(str(r.get(\"wo\", \"WO-0\"))[3:]) for r in rows if str(r.get(\"wo\", \"\")).startswith(\"WO-\")]\n\tnxt = (max(nums) + 1) if nums else 10000\n\trows.insert(0, {\"wo\": \"WO-%05d\" % nxt, \"product\": \"\", \"line\": \"Line 1\", \"qty\": 0,\n\t\t\"customer\": \"\", \"batch\": \"\", \"status\": \"draft\", \"priority\": \"normal\",\n\t\t\"due\": system.date.format(system.date.now(), \"yyyy-MM-dd\"), \"notes\": \"\"})\n\tself.props.data.rows = rows\n"
                }
              }
            ],
            "onRowsDelete": [
              {
                "type": "script",
                "scope": "G",
                "config": {
                  "script": "\t# Remove the selected rows.\n\tdoomed = set([str(i) for i in event.rowIds])\n\tself.props.data.rows = [dict(r) for r in self.props.data.rows if str(r.get(\"wo\")) not in doomed]\n"
                }
              }
            ],
            "onBatchSave": [
              {
                "type": "script",
                "scope": "G",
                "config": {
                  "script": "\t# Persist a batch save: apply every changed row by id, then rebind.\n\trows = [dict(r) for r in self.props.data.rows]\n\tchanged = {str(r[\"wo\"]): dict(r) for r in event.rows}\n\tfor i in range(len(rows)):\n\t\tk = str(rows[i].get(\"wo\"))\n\t\tif k in changed:\n\t\t\trows[i] = changed[k]\n\tself.props.data.rows = rows\n"
                }
              }
            ]
          }
        }
      }
    ]
  }
}
