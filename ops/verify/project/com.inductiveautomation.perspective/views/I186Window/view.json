              },
              {
                "id": "late",
                "label": "Late",
                "color": "#16a34a"
              },
              {
                "id": "night",
                "label": "Night",
                "color": "#8e44ad"
              },
              {
                "id": "cycle",
                "label": "Cycle",
                "color": "#e67e22"
              }
            ]
          },
          "data": {
            "events": []
          },
          "state": {
            "zoom": "day"
          }
        },
        "propConfig": {
          "props.data.events": {
            "binding": {
              "type": "expr",
              "config": {
                "expression": "now(10000)"
              },
              "transforms": [
                {
                  "type": "script",
                  "code": "\t# Shift bars for 40 days either side of today on zone-local wall clock\n\t# (naive strings = config.timezone, Europe/Brussels), plus 10-second cycles\n\t# around now for the live 45-second window.\n\tnowms = system.date.toMillis(value)\n\tout = []\n\ttoday = system.date.midnight(value)\n\tfor k in range(-40, 41):\n\t\td = system.date.format(system.date.addDays(today, k), \"yyyy-MM-dd\")\n\t\tnxt = system.date.format(system.date.addDays(today, k + 1), \"yyyy-MM-dd\")\n\t\tout.append({\"id\": \"early-\" + d, \"resourceId\": \"shifts\", \"title\": \"Early\", \"start\": d + \"T06:00:00\", \"end\": d + \"T14:00:00\", \"category\": \"early\"})\n\t\tout.append({\"id\": \"late-\" + d, \"resourceId\": \"shifts\", \"title\": \"Late\", \"start\": d + \"T14:00:00\", \"end\": d + \"T22:00:00\", \"category\": \"late\"})\n\t\tout.append({\"id\": \"night-\" + d, \"resourceId\": \"shifts\", \"title\": \"Night\", \"start\": d + \"T22:00:00\", \"end\": nxt + \"T06:00:00\", \"category\": \"night\"})\n\tdef iso(ms):\n\t\treturn system.date.format(system.date.fromMillis(long(ms)), \"yyyy-MM-dd'T'HH:mm:ss.SSSXXX\")\n\tfirst = int((nowms - 600000) // 10000)\n\tfor n in range(first, first + 120):\n\t\tt = n * 10000\n\t\tout.append({\"id\": \"cycle-%d\" % n, \"resourceId\": \"cycles\", \"title\": \"Cycle %d\" % (n % 1000), \"start\": iso(t), \"end\": iso(t + 8000), \"category\": \"cycle\"})\n\treturn out\n"
                }
              ]
            }
          }
        },
        "position": {
          "x": 24,
          "y": 50,
