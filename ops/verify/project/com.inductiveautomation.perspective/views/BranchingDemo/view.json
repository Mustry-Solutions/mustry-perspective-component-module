    "position": {
     "height": 58,
     "width": 920,
     "x": 16,
     "y": 10
    },
    "props": {
     "style": {
      "fontSize": "13px"
     },
     "text": "Branching Diagram demo \u2014 a production flow with a rework LOOP: Rework points back to Assemble, which exercises the duplicate-forwarding layout (the re-referenced subtree is pushed right so arrows always point forward). Click a node: it highlights (state.selectedNode, two-way) and fires onNodeClick. Hover Intake or Rework for the info card. Display-only component \u2014 the data is a static prop here; bind data.nodes to anything that yields the flat node array."
    },
    "type": "ia.display.label"
   },
   {
    "events": {
     "component": {
      "onNodeClick": {
       "config": {
        "script": "\tself.view.custom.lastEvent = 'onNodeClick id=' + str(event.id) + ' name=\"' + str(event.name) + '\" category=' + str(event.category)"
       },
       "scope": "G",
       "type": "script"
      }
     }
    },
    "meta": {
     "name": "branching"
    },
    "position": {
     "height": 300,
     "width": 920,
     "x": 16,
     "y": 76
