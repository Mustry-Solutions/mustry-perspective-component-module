{
  "custom": {},
  "params": {},
  "props": {
    "defaultSize": {
      "width": 1100,
      "height": 650
    }
  },
  "root": {
    "type": "ia.container.coord",
    "version": 0,
    "props": {},
    "meta": {
      "name": "root"
    },
    "children": [
      {
        "type": "ia.display.label",
        "version": 0,
        "props": {
          "text": "Pan & Zoom View demo (M0/M1) — the SynopticDemo view (2400×1500) embedded and navigable: drag to pan, wheel to zoom toward the cursor, +/−/home/fit controls, zoom badge. Click the button INSIDE the synoptic to prove embedded interactivity survives. 'Fly to Pump 3' writes the two-way state from a script.",
          "style": {
            "fontSize": "13px"
          }
        },
        "meta": {
          "name": "help"
        },
        "position": {
          "x": 16,
          "y": 6,
          "width": 860,
          "height": 40
        }
      },
      {
        "type": "ia.display.label",
        "version": 0,
        "props": {
          "text": "theme",
          "style": {
            "fontSize": "11px",
            "color": "#8a8f98",
            "textAlign": "right"
          }
        },
        "meta": {
          "name": "theme_caption"
        },
        "position": {
          "x": 884,
          "y": 14,
          "width": 44,
          "height": 16
        }
      },
      {
        "type": "ia.input.dropdown",
        "version": 0,
        "props": {
          "options": [
            {
              "value": "light",
              "label": "light"
            },
            {
              "value": "light-warm",
              "label": "light-warm"
            },
            {
              "value": "light-cool",
              "label": "light-cool"
            },
            {
              "value": "dark",
              "label": "dark"
            },
            {
              "value": "dark-warm",
              "label": "dark-warm"
            },
            {
              "value": "dark-cool",
              "label": "dark-cool"
            }
          ],
          "allowClear": false
        },
        "propConfig": {
          "props.value": {
            "binding": {
              "type": "property",
              "config": {
                "path": "session.props.theme"
              },
              "bidirectional": true
            },
            "onChange": {
              "enabled": true,
              "script": "\tval = currentValue.value if currentValue else None\n\tif val and val != self.session.props.theme:\n\t\tself.session.props.theme = val\n"
            }
          }
        },
        "meta": {
          "name": "theme_dropdown"
        },
        "position": {
          "x": 934,
          "y": 8,
          "width": 130,
          "height": 32
        }
      },
      {
        "type": "mustrysolutions.display.panzoomview",
        "version": 0,
        "props": {
          "config": {
            "viewPath": "SynopticDemo",
            "contentWidth": 2400,
            "contentHeight": 1500,
            "home": {
              "x": -1,
              "y": -1,
              "zoom": 0
            }
          }
        },
        "custom": {},
        "meta": {
          "name": "pz"
        },
        "position": {
          "x": 16,
          "y": 50,
          "width": 1068,
          "height": 540
        }
      },
      {
        "type": "ia.input.button",
        "version": 0,
        "props": {
          "text": "Fly to Pump 3"
        },
        "meta": {
          "name": "flyBtn"
        },
        "position": {
          "x": 16,
          "y": 600,
          "width": 140,
          "height": 32
        },
        "events": {
          "component": {
            "onActionPerformed": [
              {
                "type": "script",
                "scope": "G",
                "config": {
                  "script": "\t# The two-way state IS the API: write it to navigate.\n\tpz = self.getSibling(\"pz\")\n\tpz.props.state.zoom = 1.5\n\tpz.props.state.center = {\"x\": 2030, \"y\": 990}\n"
                }
              }
            ]
          }
        }
      },
      {
        "type": "ia.input.button",
        "version": 0,
        "props": {
          "text": "Fly home (fit)"
        },
        "meta": {
          "name": "homeBtn"
        },
        "position": {
          "x": 170,
          "y": 600,
          "width": 140,
          "height": 32
        },
        "events": {
          "component": {
            "onActionPerformed": [
              {
                "type": "script",
                "scope": "G",
                "config": {
                  "script": "\tpz = self.getSibling(\"pz\")\n\tpz.props.state.zoom = 0\n"
                }
              }
            ]
          }
        }
      }
    ]
  }
}
