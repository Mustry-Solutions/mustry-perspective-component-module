  "props": {
    "defaultSize": {
      "width": 1100,
      "height": 650
    }
  },
  "root": {
    "type": "ia.container.coord",
    "version": 0,
    "props": {},
    "meta": {
      "name": "root"
    },
    "children": [
      {
        "type": "ia.display.label",
        "version": 0,
        "props": {
          "text": "Pan & Zoom View demo (M0/M1) \u2014 the SynopticDemo view (2400\u00d71500) embedded and navigable: drag to pan, wheel to zoom toward the cursor, +/\u2212/home/fit controls, zoom badge. Click the button INSIDE the synoptic to prove embedded interactivity survives. 'Fly to Pump 3' writes the two-way state from a script.",
          "style": {
            "fontSize": "13px"
          }
        },
        "meta": {
          "name": "help"
        },
        "position": {
          "x": 16,
          "y": 6,
          "width": 860,
          "height": 40
        }
      },
      {
        "type": "ia.display.label",
        "version": 0,
        "props": {
          "text": "theme",
          "style": {
            "fontSize": "11px",
            "color": "#8a8f98",
            "textAlign": "right"
          }
        },
        "meta": {
          "name": "theme_caption"
        },
        "position": {
          "x": 884,
          "y": 14,
          "width": 44,
          "height": 16
        }
      },
      {
        "type": "ia.input.dropdown",
        "version": 0,
        "props": {
          "options": [
            {
              "value": "light",
              "label": "light"
            },
            {
              "value": "light-warm",
              "label": "light-warm"
            },
            {
              "value": "light-cool",
              "label": "light-cool"
            },
            {
              "value": "dark",
              "label": "dark"
            },
            {
              "value": "dark-warm",
              "label": "dark-warm"
            },
            {
              "value": "dark-cool",
              "label": "dark-cool"
            }
          ],
          "allowClear": false
        },
        "propConfig": {
          "props.value": {
            "binding": {
              "type": "property",
              "config": {
                "path": "session.props.theme"
              },
              "bidirectional": true
            },
            "onChange": {
              "enabled": true,
              "script": "\tval = currentValue.value if currentValue else None\n\tif val and val != self.session.props.theme:\n\t\tself.session.props.theme = val\n"
            }
          }
        },
        "meta": {
          "name": "theme_dropdown"
        },
        "position": {
          "x": 934,
          "y": 8,
          "width": 130,
          "height": 32
        }
      },
      {
        "type": "mustrysolutions.display.panzoomview",
        "version": 0,
        "props": {
          "config": {
            "viewPath": "SynopticDemo",
            "contentWidth": 0,
            "contentHeight": 0,
            "home": {
              "x": -1,
              "y": -1,
              "zoom": 0
            }
          },
          "data": {
            "pois": [
              {
                "name": "Tank 101",
                "x": 330,
                "y": 360,
                "zoom": 1.2,
                "flagged": false
              },
              {
                "name": "Mixer 1",
                "x": 1150,
                "y": 360,
                "zoom": 1.2,
                "flagged": false
              },
              {
                "name": "Pump 3",
                "x": 2030,
                "y": 990,
                "zoom": 1.5,
                "flagged": true
              },
              {
                "name": "Boiler",
                "x": 2050,
                "y": 330,
                "zoom": 0,
                "flagged": false
              },
              {
                "name": "Warehouse",
                "x": 1850,
                "y": 1300,
                "zoom": 1.0,
                "flagged": false
              }
            ]
          }
        },
        "custom": {},
        "meta": {
          "name": "pz"
        },
        "position": {
          "x": 16,
          "y": 50,
          "width": 1068,
          "height": 540
        }
      },
      {
        "type": "ia.input.button",
        "version": 0,
        "props": {
          "text": "Fly to Pump 3"
        },
        "meta": {
          "name": "flyBtn"
        },
        "position": {
          "x": 16,
          "y": 600,
          "width": 140,
          "height": 32
        },
        "events": {
          "component": {
            "onActionPerformed": [
              {
                "type": "script",
                "scope": "G",
                "config": {
                  "script": "\t# Named fly-to: write a data.pois name to state.target.\n\tself.getSibling(\"pz\").props.state.target = \"Pump 3\"\n"
                }
              }
            ]
          }
        }
      },
      {
        "type": "ia.input.button",
        "version": 0,
        "props": {
          "text": "Fly home (fit)"
        },
        "meta": {
          "name": "homeBtn"
        },
        "position": {
          "x": 170,
          "y": 600,
          "width": 140,
          "height": 32
        },
        "events": {
          "component": {
            "onActionPerformed": [
              {
                "type": "script",
                "scope": "G",
                "config": {
                  "script": "\tpz = self.getSibling(\"pz\")\n\tpz.props.state.zoom = 0\n"
                }
              }
            ]
          }
        }
      },
      {
        "type": "ia.input.button",
        "version": 0,
        "props": {
          "text": "Toggle Pump 3 alarm"
        },
        "meta": {
          "name": "alarmBtn"
        },
        "position": {
          "x": 325,
          "y": 600,
          "width": 190,
          "height": 32
        },
        "events": {
          "component": {
            "onActionPerformed": [
              {
                "type": "script",
                "scope": "G",
                "config": {
                  "script": "\t# Bindable in real projects: poi.flagged <- alarm state.\n\tpz = self.getSibling(\"pz\")\n\tpz.props.data.pois[2].flagged = not pz.props.data.pois[2].flagged\n"
                }
              }
            ]
          }
        }
      }
    ]
  }
}