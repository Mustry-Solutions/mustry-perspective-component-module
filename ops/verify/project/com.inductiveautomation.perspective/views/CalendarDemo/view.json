{
  "custom": {},
  "params": {},
  "props": {
    "defaultSize": { "width": 1000, "height": 720 }
  },
  "root": {
    "type": "ia.container.coord",
    "version": 0,
    "props": {},
    "meta": { "name": "root" },
    "children": [
      {
        "type": "ia.display.label",
        "version": 0,
        "props": { "text": "Calendar demo — editable. Drag empty time to create (editor pops open), click an event to edit/delete it, drag to move, drag the bottom edge to resize. Every change (create/edit/delete/move/resize) persists via a single onChange script on the calendar.", "style": { "fontSize": "13px" } },
        "meta": { "name": "help" },
        "position": { "x": 16, "y": 10, "width": 960, "height": 40 }
      },
      {
        "type": "mustrysolutions.display.calendar",
        "version": 0,
        "props": {
          "config": {
            "view": "week", "editable": true, "selectable": true, "builtInEditor": true, "scrollToHour": 8,
            "showLegend": true, "showExport": true,
            "categories": [
              { "id": "ops", "label": "Operations", "color": "#0c7bb3", "icon": "material/settings" },
              { "id": "maint", "label": "Maintenance", "color": "#e67e22", "icon": "material/build" },
              { "id": "meeting", "label": "Meetings", "color": "#8e44ad", "icon": "material/groups" }
            ]
          },
          "data": {
            "events": [
              { "id": "seed-1", "title": "Standup", "start": "2026-06-24T09:00:00", "end": "2026-06-24T09:30:00", "category": "meeting", "description": "Daily team sync in the control room. Review overnight alarms and the day's PM tasks." },
              { "id": "seed-2", "title": "Lunch", "start": "2026-06-24T12:00:00", "end": "2026-06-24T13:00:00", "category": "ops", "description": "Line 2 changeover window — no production scheduled." },
              { "id": "seed-3", "title": "Pump A service", "start": "2026-06-25T10:00:00", "end": "2026-06-25T11:30:00", "category": "maint", "description": "Scheduled preventive maintenance on pump A." },
              { "id": "seed-4", "title": "Vendor call", "start": "2026-06-24T10:00:00", "end": "2026-06-24T10:30:00", "category": "meeting", "status": "tentative" },
              { "id": "seed-5", "title": "Filter swap", "start": "2026-06-24T11:00:00", "end": "2026-06-24T11:30:00", "category": "maint", "status": "done" },
              { "id": "seed-6", "title": "Batch start", "start": "2026-06-24T13:30:00", "end": "2026-06-24T14:00:00", "category": "ops" },
              { "id": "seed-7", "title": "Safety walk", "start": "2026-06-24T14:30:00", "end": "2026-06-24T15:00:00", "category": "ops" },
              { "id": "seed-8", "title": "Shift handover", "start": "2026-06-24T15:30:00", "end": "2026-06-24T16:00:00", "category": "meeting" },
              { "id": "seed-9", "title": "Night shift", "start": "2026-06-30T22:00:00", "end": "2026-07-01T06:00:00", "category": "ops", "description": "Overnight run — crosses midnight into the next day." },
              { "id": "seed-10", "title": "Outage window", "start": "2026-06-30", "end": "2026-07-03", "allDay": true, "category": "maint", "description": "Planned multi-day maintenance outage." }
            ]
          }
        },
        "custom": {},
        "meta": { "name": "calendar" },
        "position": { "x": 16, "y": 56, "width": 968, "height": 640 },
        "events": {
          "component": {
            "onChange": [
              {
                "type": "script",
                "scope": "G",
                "config": {
                  "script": "\t# One handler for every mutation: create / edit / delete / move / resize.\n\tev = event.event\n\taction = event.action\n\trow = {\"id\": ev.id, \"title\": ev.title, \"start\": ev.start, \"end\": ev.end, \"allDay\": ev.allDay, \"category\": ev.category, \"description\": ev.description}\n\tevents = []\n\tfound = False\n\tfor e in self.props.data.events:\n\t\tcur = dict(e)\n\t\tif cur.get(\"id\") == ev.id:\n\t\t\tfound = True\n\t\t\tif action == \"delete\":\n\t\t\t\tcontinue\n\t\t\tcur = row\n\t\tevents.append(cur)\n\tif action != \"delete\" and not found:\n\t\tevents.append(row)\n\tself.props.data.events = events"
                }
              }
            ]
          }
        }
      }
    ]
  }
}
