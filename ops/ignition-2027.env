# Point the ops/ scripts at an Ignition 2027 beta gateway, side by side with
# the default 8.3 one: separate container, compose project (so a separate data
# volume) and host ports. Source it, then use the scripts as usual:
#
#   source ops/ignition-2027.env && ops/e2e.sh --fresh
export IGNITION_IMAGE=inductiveautomation/ignition:2027.2.0-beta1
export COMPOSE_PROJECT_NAME=mspc-2027
export GATEWAY_CONTAINER=mspc-ignition-2027
export GATEWAY_HTTP_PORT=9288
export GATEWAY_HTTPS_PORT=9243
# Its own .modl folder: a build for one line must not overwrite the other's module.
export GATEWAY_MODULES_DIR=ops/modules-2027
# Gradle reads these as -PignitionSdkVersion / -PignitionJavaVersion. 2027 refuses
# modules built for 8.x and bundles Java 25 (the toolchain must be installed).
export ORG_GRADLE_PROJECT_ignitionSdkVersion=2027.2.0-beta1
export ORG_GRADLE_PROJECT_ignitionJavaVersion=25
