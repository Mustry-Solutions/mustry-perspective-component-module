{
    "type": "object",
    "properties": {
        "action": {
            "type": "string",
            "description": "What happened: 'create', 'edit', 'delete', 'move' (dragged), or 'resize'."
        },
        "event": {
            "type": "object",
            "description": "The resulting event, with its final start/end. For 'delete' it's the removed event.",
            "properties": {
                "id": { "type": "string", "description": "The event's id." },
                "title": { "type": "string", "description": "The event's title." },
                "start": { "type": "string", "description": "Final start (ISO; date-only when all-day)." },
                "end": { "type": "string", "description": "Final end (ISO; date-only when all-day)." },
                "allDay": { "type": "boolean", "description": "Whether the event is all-day." },
                "category": { "type": "string", "description": "The event's category id (supplies its colour)." },
                "color": { "type": "string", "description": "Explicit colour override, if any (empty when the category supplies the colour)." },
                "description": { "type": "string", "description": "The event's notes." }
            }
        }
    }
}
