{
  "type": "object",
  "additionalProperties": false,
  "required": [],
  "properties": {
    "config": {
      "type": "object",
      "additionalProperties": false,
      "description": "Behaviour & appearance.",
      "properties": {
        "columns": {
          "type": "number",
          "default": 12,
          "minimum": 1,
          "maximum": 48,
          "description": "Grid column count; tile x/w are in these columns."
        },
        "rowHeight": {
          "type": "number",
          "default": 80,
          "minimum": 20,
          "description": "Height of one grid row in px; tile y/h are in these rows."
        },
        "gap": {
          "type": "number",
          "default": 8,
          "minimum": 0,
          "description": "Gap between tiles in px."
        },
        "arrangeable": {
          "type": "boolean",
          "default": false,
          "description": "Let operators drag/resize tiles; changes write back to state.layout and fire onLayoutChange. (Gestures land in M1.)"
        },
        "showTitles": {
          "type": "boolean",
          "default": true,
          "description": "Show each tile's title bar."
        },
        "enabled": {
          "type": "boolean",
          "default": true,
          "description": "Master interactivity switch."
        },
        "locale": {
          "type": "string",
          "default": "",
          "description": "BCP-47 locale for built-in UI text (en/fr/de/es/nl/it/pt). Empty = English."
        },
        "labels": {
          "type": "object",
          "additionalProperties": false,
          "description": "Per-key overrides for built-in UI text.",
          "properties": {
            "empty": {
              "type": "string"
            },
            "arrange": {
              "type": "string"
            },
            "done": {
              "type": "string"
            },
            "remove": {
              "type": "string"
            },
            "addTile": {
              "type": "string"
            },
            "move": {
              "type": "string"
            }
          }
        }
      }
    },
    "data": {
      "type": "object",
      "additionalProperties": false,
      "description": "Bound content.",
      "properties": {
        "tiles": {
          "type": "array",
          "description": "The tiles: [{ id, title, viewPath, viewParams:[{name,value}], x, y, w, h, minW, minH }]. x/y/w/h are grid cells (x,w in columns; y,h in rows). viewPath is a Perspective view path embedded in the tile.",
          "items": {
            "type": "object"
          },
          "default": []
        }
      }
    },
    "state": {
      "type": "object",
      "additionalProperties": false,
      "description": "Two-way runtime state (the component writes operator arrangements back).",
      "properties": {
        "layout": {
          "type": "array",
          "description": "The operator's arrangement: [{ id, x, y, w, h }] in grid cells, merged onto data.tiles by id. Pre-set or bind to open pre-arranged; the component rewrites it when the operator moves/resizes a tile (arrangeable).",
          "items": {
            "type": "object"
          },
          "default": []
        }
      }
    },
    "style": {
      "$ref": "urn:ignition-schema:schemas/style-properties.schema.json",
      "default": {
        "classes": ""
      }
    }
  }
}
