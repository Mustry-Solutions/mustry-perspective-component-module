{
    "type": "object",
    "additionalProperties": false,
    "required": [],
    "properties": {
        "config": {
            "type": "object",
            "additionalProperties": false,
            "description": "Configuration options that control behaviour and layout.",
            "default": {
                "disableDates": "past",
                "minDate": "",
                "maxDate": "",
                "shortSpanHours": 24,
                "granularity": "second",
                "firstDayMonday": true,
                "compactBelowHeight": 260,
                "compactBelowWidth": 240,
                "showPresets": true,
                "presets": [
                    { "label": "Last 24 hours", "amount": 24, "unit": "hours" },
                    { "label": "Last 7 days", "amount": 7, "unit": "days" },
                    { "label": "Last 30 days", "amount": 30, "unit": "days" }
                ]
            },
            "properties": {
                "disableDates": {
                    "enum": ["past", "future", "none"],
                    "default": "past",
                    "description": "Which side is muted/non-clickable. 'past' mutes dates before minDate (default today; Booking.com style, range builds forward). 'future' mutes dates after maxDate (default today; range builds backward). 'none' mutes nothing (pick any two dates either direction)."
                },
                "minDate": {
                    "type": "string",
                    "default": "",
                    "description": "Earliest selectable date as 'YYYY-MM-DD'. Hard lower bound regardless of disableDates."
                },
                "maxDate": {
                    "type": "string",
                    "default": "",
                    "description": "Latest selectable date as 'YYYY-MM-DD'. Hard upper bound regardless of disableDates."
                },
                "shortSpanHours": {
                    "type": "number",
                    "default": 24,
                    "description": "Threshold (hours) at which durationLabel flips from elapsed time (below) to whole days (at or above)."
                },
                "granularity": {
                    "enum": ["hour", "minute", "second"],
                    "default": "second",
                    "description": "Precision of the start/end time selectors: 'hour', 'minute', or 'second'. Times are snapped to this precision for both display and the outputs."
                },
                "firstDayMonday": {
                    "type": "boolean",
                    "default": true,
                    "description": "Start weeks on Monday (true) or Sunday (false)."
                },
                "compactBelowHeight": {
                    "type": "number",
                    "default": 260,
                    "description": "When the rendered height (px) is below this, switch from the full calendar to a compact two-field layout."
                },
                "compactBelowWidth": {
                    "type": "number",
                    "default": 240,
                    "description": "When the rendered width (px) is below this, switch from the full calendar to a compact two-field layout."
                },
                "showPresets": {
                    "type": "boolean",
                    "default": true,
                    "description": "Show the quick-preset buttons (configured by 'presets')."
                },
                "presets": {
                    "type": "array",
                    "description": "Quick-range buttons. Each rolls a window of amount*unit from now. Direction follows disableDates: forward ('Next ...') in 'past' mode, backward ('Last ...') in 'future'/'none' mode.",
                    "default": [
                        { "label": "Last 24 hours", "amount": 24, "unit": "hours" },
                        { "label": "Last 7 days", "amount": 7, "unit": "days" },
                        { "label": "Last 30 days", "amount": 30, "unit": "days" }
                    ],
                    "items": {
                        "type": "object",
                        "additionalProperties": false,
                        "properties": {
                            "label": {
                                "type": "string",
                                "default": "",
                                "description": "Button text."
                            },
                            "amount": {
                                "type": "number",
                                "default": 1,
                                "description": "How many units back from now the range starts."
                            },
                            "unit": {
                                "enum": ["hours", "days", "weeks", "months"],
                                "default": "days",
                                "description": "Unit for 'amount'."
                            }
                        }
                    }
                }
            }
        },
        "selection": {
            "type": "object",
            "additionalProperties": false,
            "description": "The current selection (date + time parts). Two-way: set these to pre-select a range.",
            "default": {
                "startDate": "",
                "endDate": "",
                "startTimeSec": 0,
                "endTimeSec": 86399
            },
            "properties": {
                "startDate": {
                    "type": "string",
                    "default": "",
                    "description": "Selected start date (date only, 'YYYY-MM-DD')."
                },
                "endDate": {
                    "type": "string",
                    "default": "",
                    "description": "Selected end date (date only, 'YYYY-MM-DD')."
                },
                "startTimeSec": {
                    "type": "integer",
                    "default": 0,
                    "description": "Start time as seconds since midnight (0 = 00:00:00)."
                },
                "endTimeSec": {
                    "type": "integer",
                    "default": 86399,
                    "description": "End time as seconds since midnight (86399 = 23:59:59)."
                }
            }
        },
        "output": {
            "type": "object",
            "additionalProperties": false,
            "description": "Derived results written by the component (bind to these).",
            "default": {
                "startDateTime": "",
                "endDateTime": "",
                "durationDays": 0,
                "durationHours": 0,
                "durationLabel": "",
                "isValid": false
            },
            "properties": {
                "startDateTime": {
                    "type": "string",
                    "default": "",
                    "description": "OUTPUT: start date + start time, local wall-clock ISO 'YYYY-MM-DDTHH:mm:ss'."
                },
                "endDateTime": {
                    "type": "string",
                    "default": "",
                    "description": "OUTPUT: end date + end time, local wall-clock ISO 'YYYY-MM-DDTHH:mm:ss'."
                },
                "durationDays": {
                    "type": "integer",
                    "default": 0,
                    "description": "OUTPUT: whole calendar days between start and end (0 = same day)."
                },
                "durationHours": {
                    "type": "number",
                    "default": 0,
                    "description": "OUTPUT: full span in hours (endDateTime - startDateTime)."
                },
                "durationLabel": {
                    "type": "string",
                    "default": "",
                    "description": "OUTPUT: pre-formatted span for display, e.g. '3 days' or '6h 30m'."
                },
                "isValid": {
                    "type": "boolean",
                    "default": false,
                    "description": "OUTPUT: true when both endpoints are set and endDateTime > startDateTime."
                }
            }
        },
        "style": {
            "$ref": "urn:ignition-schema:schemas/style-properties.schema.json",
            "default": {
                "classes": ""
            }
        }
    }
}
