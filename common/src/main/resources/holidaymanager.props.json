{
  "type": "object",
  "additionalProperties": false,
  "required": [],
  "properties": {
    "config": {
      "type": "object",
      "additionalProperties": false,
      "description": "Holiday Manager behaviour and appearance.",
      "default": {
        "locale": "",
        "editable": true,
        "allowCreate": true,
        "allowDelete": true
      },
      "properties": {
        "locale": {
          "type": "string",
          "default": "",
          "description": "BCP-47 locale selecting the built-in UI-text language (see config.labels). Empty = browser/session default."
        },
        "editable": {
          "type": "boolean",
          "default": true,
          "description": "Allow editing name/date/repeat with the shared Save/Discard tail. Edits are draft-only until Save fires onHolidaySave. False = viewer."
        },
        "allowCreate": {
          "type": "boolean",
          "default": true,
          "description": "Show the '+ New holiday' flow (Save fires onHolidaySave with isNew: true). Requires editable."
        },
        "allowDelete": {
          "type": "boolean",
          "default": true,
          "description": "Show the two-step Delete button (fires onHolidayDelete). Requires editable."
        },
        "labels": {
          "type": "object",
          "additionalProperties": false,
          "description": "Per-key overrides for built-in UI text. Unset keys follow config.locale.",
          "properties": {
            "listHeader": {
              "type": "string",
              "description": "Holiday list heading."
            },
            "noHolidays": {
              "type": "string",
              "description": "Empty-list placeholder."
            },
            "noSelection": {
              "type": "string",
              "description": "Detail placeholder when nothing is selected."
            },
            "newHoliday": {
              "type": "string",
              "description": "The list rail's create button."
            },
            "name": {
              "type": "string",
              "description": "Name input placeholder."
            },
            "nameRequired": {
              "type": "string",
              "description": "Validation: empty name."
            },
            "nameTaken": {
              "type": "string",
              "description": "Validation: duplicate name."
            },
            "date": {
              "type": "string",
              "description": "Date input label."
            },
            "dateInvalid": {
              "type": "string",
              "description": "Validation: missing/invalid date."
            },
            "repeatAnnually": {
              "type": "string",
              "description": "Repeat-annually toggle."
            },
            "repeats": {
              "type": "string",
              "description": "Rail badge: repeats annually."
            },
            "past": {
              "type": "string",
              "description": "Rail badge: non-repeating and already passed."
            },
            "nextOn": {
              "type": "string",
              "description": "Next-occurrence line; {date} is substituted."
            },
            "neverAgain": {
              "type": "string",
              "description": "Line for past non-repeating holidays."
            },
            "observedBy": {
              "type": "string",
              "description": "Hint linking holidays to observing schedules."
            },
            "save": {
              "type": "string",
              "description": "Save button."
            },
            "discard": {
              "type": "string",
              "description": "Discard-draft button tooltip."
            },
            "unsaved": {
              "type": "string",
              "description": "Unsaved-changes badge."
            },
            "delete": {
              "type": "string",
              "description": "Delete-holiday button."
            },
            "confirmDelete": {
              "type": "string",
              "description": "Second-step delete confirmation."
            },
            "moreActions": {
              "type": "string",
              "description": "Accessible name of the per-row ⋯ menu button."
            },
            "duplicate": {
              "type": "string",
              "description": "The row menu's duplicate action (prefills the create flow)."
            }
          }
        }
      }
    },
    "data": {
      "type": "object",
      "additionalProperties": false,
      "description": "The holidays to display. Bind 'holidays' from the gateway — typically an expression binding with a script transform over system.user.getHolidays() (see the HolidayDemo view for the reference script).",
      "default": {
        "holidays": []
      },
      "properties": {
        "holidays": {
          "type": "array",
          "default": [],
          "description": "Array of holidays mirroring Ignition's HolidayModel. Items stay open — extra fields ride along untouched.",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "description": "Unique holiday name (the selection key)."
              },
              "date": {
                "type": "string",
                "description": "The holiday's calendar date, 'YYYY-MM-DD'."
              },
              "repeatAnnually": {
                "type": "boolean",
                "description": "Observed every year on that month/day (Feb-29 repeats observe Feb 28 off-leap-years)."
              }
            }
          }
        }
      }
    },
    "state": {
      "type": "object",
      "additionalProperties": false,
      "description": "Two-way runtime state: the component writes user interactions back here, and writing a value drives it.",
      "default": {
        "selectedHoliday": ""
      },
      "properties": {
        "selectedHoliday": {
          "type": "string",
          "default": "",
          "description": "Name of the selected holiday (two-way). When empty, the component selects the next-upcoming holiday and writes that back."
        }
      }
    },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "description": "Read-only derived values (the component writes them; do not bind INTO them).",
      "default": {
        "count": 0,
        "isDirty": false,
        "validationErrors": []
      },
      "properties": {
        "count": {
          "type": "number",
          "default": 0,
          "description": "Number of bound holidays."
        },
        "isDirty": {
          "type": "boolean",
          "default": false,
          "description": "True while the selected holiday's draft differs from the bound data (unsaved edits)."
        },
        "validationErrors": {
          "type": "array",
          "default": [],
          "description": "Error keys blocking Save ('nameRequired' / 'nameTaken' / 'dateInvalid'); empty when the draft is saveable.",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "style": {
      "$ref": "urn:ignition-schema:schemas/style-properties.schema.json",
      "default": {
        "classes": ""
      }
    }
  }
}