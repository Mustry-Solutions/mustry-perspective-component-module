{
    "type": "object",
    "properties": {
        "config": {
            "type": "object",
            "additionalProperties": false,
            "description": "Calendar behaviour and appearance.",
            "default": {
                "view": "month",
                "showToolbar": true,
                "editable": false,
                "selectable": false,
                "weekStart": "monday",
                "locale": "",
                "showWeekends": true,
                "maxEventsPerDay": 3,
                "dayStartHour": 0,
                "dayEndHour": 24,
                "scrollToHour": 7
            },
            "properties": {
                "view": {
                    "enum": ["month", "week", "day", "list"],
                    "default": "month",
                    "description": "Initial view. The toolbar can switch between Month, Week, Day, and List at runtime."
                },
                "editable": {
                    "type": "boolean",
                    "default": false,
                    "description": "Week/Day: allow dragging events to move them and dragging their bottom edge to resize. The component does not persist changes — handle onEventDrop / onEventResize and write back."
                },
                "selectable": {
                    "type": "boolean",
                    "default": false,
                    "description": "Week/Day: allow dragging over empty time to select a range, firing onSelect (use it to open your own 'new event' editor)."
                },
                "showToolbar": {
                    "type": "boolean",
                    "default": true,
                    "description": "Show the header toolbar (previous / next / today + the month title)."
                },
                "weekStart": {
                    "enum": ["monday", "sunday"],
                    "default": "monday",
                    "description": "First day of the week."
                },
                "locale": {
                    "type": "string",
                    "default": "",
                    "description": "BCP-47 locale for month/weekday names (e.g. 'en-US', 'nl-NL'). Empty = browser/session default."
                },
                "showWeekends": {
                    "type": "boolean",
                    "default": true,
                    "description": "When false, Saturday and Sunday columns are hidden."
                },
                "maxEventsPerDay": {
                    "type": "number",
                    "default": 3,
                    "description": "Month view: max event chips per day before a '+N more' link. 0 = show all."
                },
                "dayStartHour": {
                    "type": "number",
                    "default": 0,
                    "description": "Week/Day views: first hour shown on the time axis (0-24)."
                },
                "dayEndHour": {
                    "type": "number",
                    "default": 24,
                    "description": "Week/Day views: last hour shown on the time axis (0-24, > dayStartHour)."
                },
                "scrollToHour": {
                    "type": "number",
                    "default": 7,
                    "description": "Week/Day views: hour scrolled into view initially."
                }
            }
        },
        "data": {
            "type": "object",
            "additionalProperties": false,
            "description": "The events to display. Bind 'events' to a query/dataset returning the events for the visible window (see output.visibleStart/visibleEnd).",
            "default": {
                "events": []
            },
            "properties": {
                "events": {
                    "type": "array",
                    "default": [],
                    "description": "Array of event objects. Rendered in a single pass — feed the whole visible window at once rather than per-event.",
                    "items": {
                        "type": "object",
                        "properties": {
                            "id": {
                                "type": "string",
                                "description": "Stable identifier, echoed back in onEventClick (use it for write-back)."
                            },
                            "title": {
                                "type": "string",
                                "description": "Event label shown on the chip."
                            },
                            "start": {
                                "type": "string",
                                "description": "Start, ISO 'YYYY-MM-DD' or 'YYYY-MM-DDTHH:mm:ss'."
                            },
                            "end": {
                                "type": "string",
                                "description": "End (optional), same format as start. Exclusive for all-day multi-day events."
                            },
                            "allDay": {
                                "type": "boolean",
                                "description": "All-day event (no time-of-day)."
                            },
                            "color": {
                                "type": "string",
                                "description": "Chip colour (any CSS colour). Defaults to the theme accent."
                            },
                            "display": {
                                "enum": ["default", "background"],
                                "description": "'background' renders a translucent band behind events (week/day) — e.g. downtime or availability windows."
                            },
                            "rrule": {
                                "type": "object",
                                "description": "Optional recurrence. When set, the event repeats and is expanded per visible window.",
                                "properties": {
                                    "freq": {
                                        "enum": ["daily", "weekly", "monthly"],
                                        "description": "Recurrence frequency."
                                    },
                                    "interval": {
                                        "type": "number",
                                        "description": "Repeat every N units (default 1)."
                                    },
                                    "count": {
                                        "type": "number",
                                        "description": "Max number of occurrences in the series."
                                    },
                                    "until": {
                                        "type": "string",
                                        "description": "Last date (ISO 'YYYY-MM-DD', inclusive)."
                                    },
                                    "byweekday": {
                                        "type": "array",
                                        "description": "Weekly only: weekdays to repeat on (0=Sun .. 6=Sat).",
                                        "items": { "type": "number" }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        },
        "output": {
            "type": "object",
            "additionalProperties": false,
            "description": "Read-only. Reflects the current view so bindings can fetch only what's visible.",
            "default": {
                "currentView": "month",
                "visibleStart": "",
                "visibleEnd": ""
            },
            "properties": {
                "currentView": {
                    "type": "string",
                    "description": "The active view."
                },
                "visibleStart": {
                    "type": "string",
                    "description": "First date shown in the grid (ISO 'YYYY-MM-DD'). Bind your query: date >= visibleStart."
                },
                "visibleEnd": {
                    "type": "string",
                    "description": "One day past the last date shown (ISO 'YYYY-MM-DD'), half-open. Bind your query: date < visibleEnd."
                }
            }
        },
        "style": {
            "$ref": "urn:ignition-schema:schemas/style-properties.schema.json",
            "default": {
                "classes": ""
            }
        }
    }
}
